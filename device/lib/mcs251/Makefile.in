# MCS251 run-time support library

VPATH  = @srcdir@
srcdir = @srcdir@

top_srcdir   = @top_srcdir@
top_builddir = @top_builddir@

LIB_TYPE = @LIB_TYPE@
AS = $(top_builddir)/bin/sdas251
SDAR = $(top_builddir)/bin/sdar

override PORTDIR = ../build/$(PORT)

MCS51_RUNTIME = $(top_srcdir)/device/lib/mcs51
OBJ = crtstart.rel crtxinit.rel crtxclear.rel crtclear.rel \
      crtpagesfr.rel crtxstack.rel crtxpush.rel crtxpushr0.rel \
      crtxpop.rel crtxpopr0.rel gptr_cmp.rel \
      atomic_flag_test_and_set.rel atomic_flag_clear.rel
LIB = mcs251.lib

MCS251_ASM_OBJ = crtxinit.rel crtxclear.rel \
               atomic_flag_test_and_set.rel atomic_flag_clear.rel
MCS51_GENERATED_ASM = $(filter-out $(MCS251_ASM_OBJ:.rel=.asm),$(OBJ:.rel=.asm))

ASFLAGS = -plosgff

# Runtime assembly is linked under the same ABI gate as compiler-generated
# objects.  The parent device/lib makefile supplies MODELFLAGS for the four
# MCS-251 library variants; derive the approved signature from those flags.
MCS251_ABI_MODEL = $(if $(findstring --model-large,$(MODELFLAGS)),large,small)
MCS251_ABI_STACK_AUTO = $(if $(findstring --stack-auto,$(MODELFLAGS)),1,0)
MCS251_ABI_SIGNATURE = stc32-mcs251 abi-major=1 abi-minor=0 target=mcs251 \
model=$(MCS251_ABI_MODEL) stack-auto=$(MCS251_ABI_STACK_AUTO) xstack=0 \
intlong-reent=$(MCS251_ABI_STACK_AUTO) float-reent=$(MCS251_ABI_STACK_AUTO) \
reg-params=1 all-callee-saves=0 sdcccall=2 regset=r0-r9,r12-r15 \
compiler-build=mcs251-abi1.0-r1

all: $(PORTDIR)/$(LIB)

$(PORTDIR)/$(LIB): $(OBJ) Makefile
ifeq ($(LIB_TYPE), SDCCLIB)
	rm -f $@
	$(top_builddir)/bin/sdcclib -a $@ $(OBJ)
else ifeq ($(LIB_TYPE), AR)
	$(SDAR) -rcSD $@ $(OBJ)
else ifeq ($(LIB_TYPE), RANLIB)
	$(SDAR) -rcD $@ $(OBJ)
else
	rm -f $@
	for object in $(basename $(OBJ)); do echo $$object >> $@; done
	cp $(OBJ) $(PORTDIR)
endif

$(MCS251_ASM_OBJ): %.rel: $(srcdir)/%.asm
	{ printf '\t.optsdcc %s\n' "$(MCS251_ABI_SIGNATURE)"; cat $<; } > $*.mcs251.asm
	-$(AS) $(ASFLAGS) $*.mcs251.asm
	test -f $*.mcs251.rel && mv $*.mcs251.rel $*.rel
	test -f $*.mcs251.lst && mv $*.mcs251.lst $*.lst
	test -f $*.mcs251.sym && mv $*.mcs251.sym $*.sym
	rm -f $*.mcs251.asm

%.rel: $(MCS51_RUNTIME)/%.asm
	{ printf '\t.optsdcc %s\n' "$(MCS251_ABI_SIGNATURE)"; sed \
		-e 's/\([[:space:]]\)lcall\([[:space:]]\)/\1ecall\2/g' \
		-e 's/\([[:space:]]\)ljmp\([[:space:]]\)/\1ejmp\2/g' \
		-e 's/^\([[:space:]]*\)mov\([[:space:]][[:space:]]*\)sp,#__start__stack/\1mov\2spx,#__start__stack/' \
		-e 's/^\([[:space:]]*\)ret$$/\1eret/' \
		-e 's/^\([[:space:]]*\)ret\([[:space:];]\)/\1eret\2/' \
		$<; } > $*.mcs251.asm
	-$(AS) $(ASFLAGS) $*.mcs251.asm
	test -f $*.mcs251.rel && mv $*.mcs251.rel $*.rel
	test -f $*.mcs251.lst && mv $*.mcs251.lst $*.lst
	test -f $*.mcs251.sym && mv $*.mcs251.sym $*.sym
	rm -f $*.mcs251.asm

clean:
	rm -f $(MCS51_GENERATED_ASM) *.rel *.sym *.lst *~ *.lib

distclean: clean
	rm -f Makefile
